# --- Frontend environment variables ---
# Copy this file to `.env.local` and fill in real values for your environment.
# DO NOT commit `.env.local` or any file containing real secrets.

# Backend API base URL (must include /api/v1).
# Local dev:  http://localhost:4000/api/v1
# Production: https://your-backend-domain.com/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000/api/v1

# Public-facing app URL — used in OG tags / metadata. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe publishable key (NEXT_PUBLIC_ prefix required so Next.js exposes it
# to the client). Use the test key in dev, live key in production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
